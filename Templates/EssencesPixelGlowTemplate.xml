<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <!-- the MarchingAntsTemplate technique (Blizzard_SharedXML/MarchingAnts.xml): repeating textures scrolled by the engine instead of OnUpdate -->
    <Frame name="EssencesPixelGlowTemplate" virtual="true" hidden="true" roundLayoutToNearestPixel="true">
        <Layers>
            <Layer level="ARTWORK" textureSubLevel="7">
                <Texture parentKey="Top" roundLayoutToNearestPixel="true">
                    <Size x="0" y="1" />
                    <Anchors>
                        <Anchor point="TOPLEFT" />
                        <Anchor point="TOPRIGHT" />
                    </Anchors>
                </Texture>
                <Texture parentKey="Right" roundLayoutToNearestPixel="true">
                    <Size x="1" y="0" />
                    <Anchors>
                        <Anchor point="TOPRIGHT" />
                        <Anchor point="BOTTOMRIGHT" />
                    </Anchors>
                </Texture>
                <Texture parentKey="Bottom" roundLayoutToNearestPixel="true">
                    <Size x="0" y="1" />
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" />
                        <Anchor point="BOTTOMRIGHT" />
                    </Anchors>
                </Texture>
                <Texture parentKey="Left" roundLayoutToNearestPixel="true">
                    <Size x="1" y="0" />
                    <Anchors>
                        <Anchor point="TOPLEFT" />
                        <Anchor point="BOTTOMLEFT" />
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Animations>
            <!-- one dash spacing per 0.625s: LibCustomGlow's lap every 5s (frequency 0.2) with 8 dashes -->
            <AnimationGroup parentKey="Animation" looping="REPEAT">
                <TextureCoordTranslation childKey="Top" duration="0.625" offsetU="-1" offsetV="0" />
                <TextureCoordTranslation childKey="Right" duration="0.625" offsetU="-1" offsetV="0" />
                <TextureCoordTranslation childKey="Bottom" duration="0.625" offsetU="-1" offsetV="0" />
                <TextureCoordTranslation childKey="Left" duration="0.625" offsetU="-1" offsetV="0" />
            </AnimationGroup>
        </Animations>
    </Frame>
</Ui>
